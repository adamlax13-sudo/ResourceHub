# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# OpenAI Configuration (for AI-powered search)
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key-here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS allowed origins (comma-separated). Falls back to built-in defaults if unset.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Admin API key for protected endpoints
ADMIN_API_KEY=your-secure-api-key-here

# Mapbox (for map view + geocoding)
# Public token (pk.) — client-side map rendering. URL-restrict in Mapbox dashboard.
MAPBOX_PUBLIC_TOKEN=pk.your-public-token-here
# Secret token (sk.) — server-side geocoding only. Never exposed to client.
MAPBOX_SECRET_TOKEN=sk.your-secret-token-here
